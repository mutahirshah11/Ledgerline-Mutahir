{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-c3/types/**/*.ts",
    ".next-c3/dev/types/**/*.ts",
    ".next-us7/types/**/*.ts",
    ".next-us7/dev/types/**/*.ts",
    ".next-us5/types/**/*.ts",
    ".next-us5/dev/types/**/*.ts",
    ".next-us7-baseline/types/**/*.ts",
    ".next-us7-baseline/dev/types/**/*.ts",
    ".next-us5-b/types/**/*.ts",
    ".next-us5-b/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-verify2/types/**/*.ts",
    ".next-verify2/dev/types/**/*.ts",
    ".next-fix/types/**/*.ts",
    ".next-fix/dev/types/**/*.ts",
    ".next-solo/types/**/*.ts",
    ".next-solo/dev/types/**/*.ts",
    ".next-dbg/types/**/*.ts",
    ".next-dbg/dev/types/**/*.ts",
    ".next-w1/types/**/*.ts",
    ".next-w1/dev/types/**/*.ts",
    ".next-fr/types/**/*.ts",
    ".next-fr/dev/types/**/*.ts",
    ".next-hardening/types/**/*.ts",
    ".next-hardening/dev/types/**/*.ts",
    ".next-final/types/**/*.ts",
    ".next-final/dev/types/**/*.ts",
    ".next-regress/types/**/*.ts",
    ".next-regress/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-*"
  ]
}
